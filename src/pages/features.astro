---
import Base from '@/layouts/Base.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { Button } from '@/components/ui/Button';

const sections = [
  {
    label: 'HTTP Engine',
    title: 'Built on undici',
    desc: "Scrapeman's HTTP core uses undici, Node's official HTTP client and the layer behind built-in fetch. Spec-compliant, fast, with proxy and HTTP/2 support out of the box.",
    features: [
      { name: 'All HTTP methods', desc: 'GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS, plus custom verbs like PROPFIND and QUERY.' },
      { name: 'HTTP/1.1 and HTTP/2', desc: 'Per-request allowH2 toggle via ALPN negotiation.' },
      { name: 'Per-request TLS verify toggle', desc: 'Skip cert checks the way curl does with -k. Self-signed proxies, expired certs, mitmproxy debug. The URL bar shows a red Insecure badge while it is on.' },
      { name: 'Custom headers', desc: 'Set any header, override auto-managed ones, or disable them per request. Bulk-edit toggle switches the table to a Key: Value textarea.' },
      { name: 'Request body types', desc: 'JSON, form-urlencoded, multipart, raw text, binary, plus a CodeMirror editor with {{var}} highlight, autocomplete, and lenient JSON beautify with auto-fix.' },
      { name: 'Query parameters', desc: 'URL bar and Params table stay two-way synced. Disabled rows survive saves and reloads.' },
      { name: 'Cmd+R parallel send', desc: 'Each press fires another request without cancelling the in-flight one. Live HUD tracks every parallel send with status and elapsed duration.' },
      { name: 'Proxy support', desc: 'HTTP / HTTPS proxies with basic auth via undici ProxyAgent.' },
    ],
  },
  {
    label: 'Response Handling',
    title: 'Nothing hidden, nothing lost',
    desc: 'Responses arrive fully decompressed and rendered with syntax highlighting. Large bodies stay smooth thanks to virtualization.',
    features: [
      { name: 'Auto-decompression', desc: 'gzip, brotli, and deflate responses decode automatically.' },
      { name: 'SSE event streaming', desc: 'text/event-stream responses get an Events mode with id, event, retry, and a JSON tree per data block. Export as JSON.' },
      { name: '200 MB body cap', desc: 'Large responses captured fully. Virtualized rendering means a 5 MB body still scrolls smoothly. Save the response to a file with one click.' },
      { name: 'Pretty modes for every kind', desc: 'CodeMirror with one-dark in dark mode for JSON, HTML, XML, JavaScript, and CSS. JSON also has a collapsible Tree view with JSONPath copy.' },
      { name: 'HTML preview with styles', desc: 'Sandboxed iframe renders external CSS, images, and fonts. A base href is injected so relative URLs resolve to the originating server.' },
      { name: 'Response body search', desc: '150 ms debounce, line-indexed match table, Enter / Shift+Enter navigation. The query persists across sends and auto re-runs.' },
      { name: 'Dev Tools tab', desc: 'Timing waterfall (DNS / TCP / TLS / TTFB / Download), sent URL and headers, redirect chain, TLS cert info with days-remaining warning, remote IP and HTTP version.' },
      { name: 'Timing breakdown', desc: 'DNS, connect, TLS, TTFB, and download segmented with millisecond labels.' },
    ],
  },
  {
    label: 'Authentication',
    title: 'Every scheme. No friction.',
    desc: 'Six auth types built in. Tokens cache, refresh before expiry, and dedup across concurrent sends.',
    features: [
      { name: 'Basic, Bearer, API Key', desc: 'Plus AWS Signature v4 via aws4. API Key supports header and query placement.' },
      { name: 'OAuth 2.0 client credentials', desc: 'Token fetched automatically, cached until expiry, refreshed before it expires. Concurrent requests share one in-flight fetch.' },
      { name: 'OAuth 2.0 authorization code', desc: 'Browser-based flow with a local loopback callback on an ephemeral port. State validated on return.' },
      { name: 'OAuth 2.0 + PKCE', desc: 'S256 code challenge, no client secret required. Refresh token flow with proactive refresh 30 seconds before expiry.' },
      { name: 'OIDC discovery', desc: 'Point at a .well-known/openid-configuration URL and Scrapeman autofills Token URL, Auth URL, and supported scopes.' },
      { name: 'Token placement', desc: 'Authorization header (default), query param, or form body field.' },
      { name: 'JWT inspector', desc: 'Decodes header and payload of access_token and id_token with a live exp countdown. Display only, no signature check.' },
    ],
  },
  {
    label: 'Scripts and load testing',
    title: 'Pre/post scripts and a real load runner',
    desc: 'JavaScript before and after every request. Stress-test any endpoint without leaving the app.',
    features: [
      { name: 'Pre-request scripts', desc: 'Mutate URL, headers, and body via the req proxy. Read and write variables across folder, collection, environment, and global scopes via bru.' },
      { name: 'Post-response scripts', desc: 'Inspect res.getStatus() and res.getBody() (auto-parsed JSON). Run assertions with test() / expect().toBe(). Failures render in the Scripts response tab.' },
      { name: 'vm sandbox', desc: 'Node vm context with a 5-second timeout. No require, process, or import. Scripts round-trip through .sman as YAML literal blocks.' },
      { name: 'Load runner', desc: 'Bounded concurrency, live RPS, p50/p95/p99 latency, status histogram, error kind breakdown. Per-tab isolation so a run survives tab switches.' },
      { name: 'Watched response headers', desc: 'Track up to 10 headers across iterations. Per-status value distribution, top-5 values, numeric stats (min/max/avg/p50/p95/p99) when 95% parse as numbers.' },
      { name: 'Save failed responses', desc: 'Ring buffer (1 to 1000) captures bodies of failed iterations. Export as JSON for offline triage.' },
      { name: 'Collection runner', desc: 'Run any folder sequentially or in parallel. CSV-driven iterations, abort mid-run, export the report as JSON, CSV, or self-contained HTML.' },
    ],
  },
  {
    label: 'Variables and collections',
    title: 'Scoped variables, git-friendly files',
    desc: 'One .sman YAML file per request. Variables resolve through five scopes with a clear precedence.',
    features: [
      { name: '.sman file format', desc: 'Custom YAML with stable key order. Bodies above 4 KB auto-promote to a sidecar file. Legacy .req.yaml files read as-is and migrate on first save.' },
      { name: 'Folder, collection, global', desc: 'Variables live at every level via _folder.yaml, .scrapeman/collection.yaml, and .scrapeman/globals.yaml. Auth blocks at the folder or collection level inherit down the tree.' },
      { name: 'Scope precedence', desc: 'Folder chain > active environment > collection > global > built-in. Highest match wins.' },
      { name: 'Built-in dynamics', desc: '{{random}}, {{uuid}}, {{timestamp}}, {{timestampSec}}, {{isoDate}}, {{randomInt}} re-resolve on every send.' },
      { name: 'Multi-workspace', desc: 'Open several workspaces in one window and switch from the sidebar header. Per-workspace tabs, env, and view persist across restart.' },
      { name: 'Restore unsaved tabs on restart', desc: 'Builder state (URL, headers, body, auth, settings, scripts) round-trips through localStorage. Transient runtime is stripped before saving.' },
      { name: 'Per-request git sync toggle', desc: 'Right-click a request to stop syncing it. Backed by .git/info/exclude so teammates never see it. Cmd+Shift+H toggles on the active tab.' },
      { name: 'In-app git', desc: 'Status bar branch, source-control panel, stage / commit / push / pull, diff viewer. Diverged-branch dialog offers Rebase or Merge commit.' },
    ],
  },
  {
    label: 'Scraping-first features',
    title: 'Built for real-world targets',
    desc: 'Scrape.do native mode, anti-bot detection, UA presets, rotating proxies, and rate limiting. The scraping use case is a one-toggle affair.',
    features: [
      { name: 'Scrape.do native mode', desc: 'One toggle rewrites the URL to api.scrape.do and forwards residential rotation, JS rendering, geo targeting, and ban retry parameters.' },
      { name: 'Anti-bot detection banner', desc: 'Cloudflare, HTTP 429, CAPTCHA markers, and bot-block bodies surface as a dismissable banner above the response with a Retry-After countdown.' },
      { name: 'User-Agent presets', desc: '9 presets: Scrapeman default, Chrome 124 macOS / Windows, Firefox 125 macOS / Windows, Safari 17 macOS / iOS, Googlebot, curl. Custom UA in Headers always overrides.' },
      { name: 'Rotating proxy', desc: 'List of proxy URLs with round-robin or random strategy. Collection Runner rotates per request, Load Runner rotates per concurrent slot.' },
      { name: 'Per-request rate limit', desc: 'Fixed delay plus optional jitter (min / max ms). Honoured by Collection Runner and Load Runner.' },
      { name: 'Cookie jar UI', desc: 'Domain filter, manual add and inline edit, httpOnly value masking with reveal, JSON and Netscape exports, paste-import accepting document.cookie or cookies.txt.' },
      { name: 'Headers Overflow fix', desc: 'undici maxHeaderSize bumped to 256 KiB so Cloudflare-fronted responses with big rotating cookies and signed proof-of-work tokens stop bouncing.' },
    ],
  },
  {
    label: 'WebSocket',
    title: 'Bidirectional WebSocket on every tab',
    desc: 'A WebSocket pane lives next to the HTTP request builder. Connect, send, and trace messages without leaving the tab.',
    features: [
      { name: 'Live timeline', desc: 'Each message has a direction arrow, timestamp, and payload. JSON payloads expand inline with the Tree viewer.' },
      { name: 'Application-level ping', desc: 'Keep-alive ping every 30 seconds with round-trip latency in the pong row.' },
      { name: 'Per-connection proxy', desc: 'Routes through standard HTTP proxies or Scrape.do WS proxy endpoints.' },
      { name: 'Tab-switch survival', desc: 'Switching tabs leaves the connection open. The timeline picks up where you left off when you come back.' },
      { name: 'Export timeline', desc: 'Save the full message log as JSON for replay or audit.' },
    ],
  },
  {
    label: 'Import and export',
    title: 'Bring your existing collections',
    desc: 'Read from five external formats. Export history as HAR. More export targets on the roadmap.',
    features: [
      { name: 'OpenAPI 3.0.x / 3.1.x and Swagger 2.0', desc: 'Parse from URL or paste. Tags become folders, paths and methods become requests, security schemes become auth, server URLs go to {{base_url}}.' },
      { name: 'Postman v2.1', desc: 'Folder hierarchy, auth (basic, bearer, apikey, oauth2, awsSigV4), variables, body modes round-trip.' },
      { name: 'Bruno .bru folders', desc: 'Reads INI-like .bru files: methods, headers, auth (bearer / basic), bodies, query and path params.' },
      { name: 'Insomnia v4', desc: 'Walks the resource list by type, rebuilds the folder tree from _id / parentId, maps all five auth types.' },
      { name: 'curl', desc: 'Built on @scrape-do/curl-parser. Handles ANSI-C $\'...\' quoting, multipart, urlencoded, proxy, referer, basic auth, cookies, custom UA.' },
      { name: 'HAR 1.2 round-trip', desc: 'Import Chrome DevTools HAR exports. Export history back to HAR. Round-trip tested.' },
      { name: 'Code export', desc: 'Generate curl, JS fetch, Python requests, or Go net/http from the current request. Inline resolved values or keep {{var}} templates.' },
    ],
  },
  {
    label: 'Privacy',
    title: 'Zero data ever leaves your machine',
    desc: 'No analytics. No crash reporting. No cloud sync. No account. Your requests and responses stay on your disk.',
    features: [
      { name: 'Local YAML and JSONL', desc: 'Collections live as .sman files in a workspace folder you choose. History is per-workspace JSONL in app data.' },
      { name: 'Template-preserving history', desc: '{{token}} stays {{token}} on disk. Secrets are never baked in.' },
      { name: 'No telemetry', desc: 'Zero metrics, analytics, or usage data collected or transmitted.' },
      { name: 'No account required', desc: 'Download and run. No registration, no email, no OAuth.' },
      { name: 'No cloud sync', desc: 'Nothing is backed up to a third-party server. Your data is your responsibility.' },
      { name: 'Open source', desc: 'Apache 2.0 with an explicit patent grant in §3. Read the source on GitHub.' },
    ],
  },
];
---

<Base
  title="Scrapeman features — every paid Postman feature, free"
  description="Unlimited history, env vars, and collection runs. Single-request load testing. Git-friendly YAML collections. OAuth2, AWS SigV4, and three other auth schemes. Native Scrape.do proxy. HTTP/2 and gzip/brotli. The full feature list."
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="hero-bg noise pt-20 pb-20 text-center">
      <div class="max-w-3xl mx-auto px-6">
        <p class="section-label mb-4" style="animation: fade-up 0.5s ease-out both;">All features</p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-[var(--text-strong-950)] mb-6" style="animation: fade-up 0.5s ease-out 0.1s both;">
          Everything.<br />
          <span class="gradient-text">Nothing extra.</span>
        </h1>
        <p class="text-lg text-[var(--text-sub-600)] leading-relaxed" style="animation: fade-up 0.5s ease-out 0.2s both;">
          Scrapeman is built for scraping engineers. Six auth schemes, a load runner with watched headers, a WebSocket client, pre and post-request scripts, native Scrape.do mode, and a git-friendly .sman file format. Apache 2.0, no account, no cloud sync.
        </p>
      </div>
    </section>

    <!-- Feature sections -->
    <div class="max-w-5xl mx-auto px-6 py-16 space-y-24">
      {sections.map((section, si) => (
        <div class="reveal">
          <div class="mb-8">
            <p class="section-label mb-2">{section.label}</p>
            <h2 class="text-2xl font-bold tracking-tighter text-[var(--text-strong-950)] mb-3">{section.title}</h2>
            <p class="text-[var(--text-sub-600)] max-w-2xl">{section.desc}</p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" data-stagger>
            {section.features.map(f => (
              <div class="p-5 rounded-xl border border-[var(--stroke-soft-200)] bg-[var(--bg-weak-50)] hover:border-[var(--stroke-strong-950)] transition-colors" data-stagger-child>
                <div class="flex items-center gap-2 mb-2">
                  <div class="w-4 h-4 rounded-full bg-[var(--success-alpha-10)] flex-shrink-0 flex items-center justify-center">
                    {/* Checkmark uses success-base token for the stroke */}
                    <svg width="8" height="8" viewBox="0 0 12 12" fill="none">
                      <path d="M2 6l3 3 5-5" stroke="var(--success-base)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <span class="font-semibold text-sm text-[var(--text-strong-950)]">{f.name}</span>
                </div>
                <p class="text-xs text-[var(--text-soft-400)] leading-relaxed pl-6">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <section id="download" class="py-24 text-center bg-[var(--bg-weak-50)]">
      <div class="max-w-xl mx-auto px-6 reveal">
        <h2 class="text-3xl font-bold tracking-tighter text-[var(--text-strong-950)] mb-4">
          Ready to try it?
        </h2>
        <p class="text-[var(--text-sub-600)] mb-8">Free. Local. No account. Download and run in 30 seconds.</p>
        <Button variant="primary" size="lg" asChild>
          <a href="/#download" class="inline-flex items-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Download Scrapeman
          </a>
        </Button>
      </div>
    </section>
  </main>
  <Footer />
</Base>
